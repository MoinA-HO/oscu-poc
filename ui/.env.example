# Base URL for the API.
#
# Leave EMPTY in development: vite.config.ts proxies /api to the API on
# localhost:7501, so requests are same-origin and CORS does not apply.
#
# Set it for deployed environments, e.g.
#   VITE_API_BASE_URL=https://app-referrals-api-dev.azurewebsites.net
#
# NOTE: this is the ORIGIN ONLY, with no path. The source template set it to
# ".../api/data-table" and then appended "/api/data-table" again in the client,
# producing a doubled path.
VITE_API_BASE_URL=
