registry=https://registry.npmjs.org/

# The Home Office design system feed. Nothing in this project resolves from it
# yet: src/components/hods is a local adapter built on the public
# govuk-frontend package, so the UI runs without feed access.
#
# When access is available, authenticate against this feed, add
# @ukhoautomation/hods-react to package.json, and rewrite the adapters in
# src/components/hods to re-export the real components. See that folder's
# README.md — no feature code changes.
@ukhoautomation:registry=https://pkgs.dev.azure.com/ukhomeoffice/_packaging/ACReact/npm/registry/
always-auth=true
