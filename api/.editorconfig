root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = warning        # remove unnecessary usings

# Prefer explicit, readable code
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:error
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Naming: interfaces prefixed with I, private fields _camelCase
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

[*Tests.cs]
# Test method names use MethodName_State_ExpectedResult, which trips this rule.
dotnet_diagnostic.CA1707.severity = none

# ---------------------------------------------------------------------------
# Generated code
# ---------------------------------------------------------------------------
# EF Core writes migrations and the model snapshot itself, using block-scoped
# namespaces and its own import set. They are regenerated on every schema
# change, so hand-formatting them to satisfy our style rules would be undone by
# the next `dotnet ef migrations add`.
#
# generated_code tells the analysers these files are machine-written; the two
# explicit severities cover analysers that do not honour that flag.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0040.severity = none
