<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Asp.Versioning.Http" />
    <!--
      Asp.Versioning.Mvc.ApiExplorer supplies IApiVersionDescriptionProvider,
      which the per-version Swagger document generation needs. Despite the
      "Mvc" in the package id it is the supported route for minimal APIs; we do
      NOT reference Asp.Versioning.Mvc itself, so no MVC services are added.
    -->
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="FluentValidation" />
    <!--
      Required by the EF Core tools in the STARTUP project, not just where the
      DbContext lives. Persistence references it with PrivateAssets=all, which
      deliberately stops it flowing transitively, so it has to be declared here
      as well or `dotnet ef` refuses to run.

      PrivateAssets=all keeps design-time tooling out of the published output.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OSCU.Application\OSCU.Application.csproj" />
    <ProjectReference Include="..\OSCU.Domain\OSCU.Domain.csproj" />
    <ProjectReference Include="..\OSCU.Infrastructure\OSCU.Infrastructure.csproj" />
    <ProjectReference Include="..\OSCU.Persistence\OSCU.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Top-level statements always emit the Program class as internal, and
      WebApplicationFactory<Program> needs to reach it. Everything else in this
      assembly is public, so this is the only entry still required.
    -->
    <InternalsVisibleTo Include="OSCU.Api.IntegrationTests" />
  </ItemGroup>

</Project>
